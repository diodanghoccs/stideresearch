# STideResearch — environment schema. Copy to .env.local; never commit real values.
# All variables are SERVER-ONLY (no NEXT_PUBLIC_ prefix). The client must never read secrets.

# --- Inference (owner: Tuấn) ---
# Read by src/inference for readiness only: unset -> "not-configured", set -> "not-implemented"
# until a real adapter exists. The value itself is never returned by /api/health.
INFERENCE_PROVIDER=
# Proposed names for the real adapter (not read by base code yet):
INFERENCE_MODEL=
INFERENCE_API_KEY=

# --- Tide (owner: Trí) ---
# Per the official Tide playbook, the browser provider takes the adapter JSON exported from
# TideCloak (data/tidecloak.json, gitignored) directly, not env vars. Server-side JWT/DPoP
# verification config is defined by Trí when wiring src/tide/server.ts (not read by base code yet).
TIDECLOAK_ADAPTER_PATH=data/tidecloak.json
